<!DOCTYPE html>
<html>
<head>
    <meta charset='utf-8'>
    <meta http-equiv='X-UA-Compatible' content='IE=edge'>
    <title>Update User Data</title>
    <meta name='viewport' content='width=device-width, initial-scale=1'>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0&icon_names=home" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,100;0,300;0,400;0,500;0,700;0,900;1,100;1,300;1,400;1,500;1,700;1,900&display=swap" rel="stylesheet">
    <link rel='stylesheet' type='text/css' media='screen' href='/main.css'>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

</head>
<body>
   <nav class="navbar navbar-expand-lg navbar-light bg-light border">
    <div class="">
      <ul class="navbar-nav px-2">
        <li class="nav-item">
          <a class="nav-link border navbar-brand fw-bold" href="/">
            <span class="material-symbols-outlined align-text-top">
            home</span>
            App Home</a>
        </li>
        <li class="nav-item">
          <a class="nav-link navbar-brand border" href="/users">All User Data</a>
        </li>
        <li class="nav-item">
          <a class="nav-link navbar-brand border" href="/users/add">Add User Data</a>
        </li>
      </ul>
    </div>
  </nav>

  
<div class="container">
  <h1>Update User Data</h1>
  <p class="text-danger">Please do not include any real data, this is a test project and the data is public</p>
      <div class="my-2 p-1 card bg-light">
        <form method="POST" action="/users/user-update">
        <ul class="list-group list-group-flush">

          <li class="list-group-item"><span class="bold">Username:</span> {{userData.username}}</li>
          <li class="list-group-item form-label">
            <label class="bold">Update username: <input class="form-control" name="username" type="text"  value="{{userData.username}}"></label>
          </li>

          <li class="list-group-item"><span class="bold">Bio:</span>  {{userData.bio}}</li>
          <li class="list-group-item form-label">
            <label name="bio" class="bold">Update bio: <input class="form-control" name="bio" type="text"  value="{{userData.bio}}"></label>
          </li>

          <li class="list-group-item"><span class="bold">Age:</span>  {{userData.age}}</li>
          <li class="list-group-item form-label">
            <label class="bold">Update age: <input class="form-control" name="age" min="0" max="200" type="number"  value="{{userData.age}}"></label>
          </li>

          <li class="list-group-item"><span class="bold">Permission:</span>  {{userData.permission}}</li>  
          <li class="list-group-item form-label">
            <span class="bold">Update user permission (default = standard):</span>
            <div class="form-check">
                <input class="form-check-input" type="radio" name="permission" value="Standard-Permission" checked>
                <label class="form-check-label" for="User-Permission">
                    Standard-Permission
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="permission" value="Manager-Permission">
                <label class="form-check-label" for="Manager-Permission">
                    Manager-Permission
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="permission" value="Administrator-Permission">
                <label class="form-check-label" for="Administrator-Permission">
                    Administrator-Permission
                </label>
              </div>
          </li> 
          <input  name="id" type="hidden" value="{{userData.id}}">
          <input type="submit" class="mx-3 m-2" value="Update Post">

        </ul> 
        </form>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>